# Copy this file to .env and change every value. Never commit .env.
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env

LEAVEDESK_ENVIRONMENT=dev
LEAVEDESK_LOG_LEVEL=INFO

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LEAVEDESK_JWT_SECRET=replace-with-at-least-32-random-characters
LEAVEDESK_ACCESS_TOKEN_MINUTES=30

# Password for the demo users (asha@leavedesk.dev, ravi@leavedesk.dev, ...).
LEAVEDESK_SEED_PASSWORD=replace-me-too

# Used by the db service in docker-compose.yml. Three database roles, three passwords:
#   leavedesk           the superuser, for emergencies only
#   leavedesk_migrator  owns the tables, runs Alembic
#   leavedesk_app       what the API logs in as: read and write rows only
POSTGRES_PASSWORD=replace-with-a-database-password
LEAVEDESK_MIGRATOR_DB_PASSWORD=replace-with-another-password
LEAVEDESK_APP_DB_PASSWORD=replace-with-a-third-password

# The port on this computer. Change it if 5432 is already taken (then use the
# same port in the URLs below).
POSTGRES_HOST_PORT=5432

# Day 4: the port of the web app in `docker compose up` (http://localhost:8080).
WEB_HOST_PORT=8080

# Day 3: where the app and Alembic find PostgreSQL. Use the matching passwords above.
# localhost:5432 is the db service from docker-compose.yml.
# If Windows blocks psycopg ("Application Control policy"), use postgresql+pg8000://
# instead of postgresql+psycopg:// in all three URLs below. See README, "Windows security".
LEAVEDESK_DATABASE_URL=postgresql+psycopg://leavedesk_app:replace-with-a-third-password@localhost:5432/leavedesk
LEAVEDESK_MIGRATION_DATABASE_URL=postgresql+psycopg://leavedesk_migrator:replace-with-another-password@localhost:5432/leavedesk

# Only for running the database tests. They create and drop their own database
# on this server, so point it at the "postgres" maintenance database.
LEAVEDESK_TEST_DATABASE_URL=postgresql+psycopg://leavedesk:replace-with-a-database-password@localhost:5432/postgres
