# Copy this file to .env and change every value. Never commit .env.
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env

LEAVEDESK_ENVIRONMENT=dev
LEAVEDESK_LOG_LEVEL=INFO

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LEAVEDESK_JWT_SECRET=replace-with-at-least-32-random-characters
LEAVEDESK_ACCESS_TOKEN_MINUTES=30

# Password for the demo users (asha@leavedesk.dev, ravi@leavedesk.dev, ...).
LEAVEDESK_SEED_PASSWORD=replace-me-too

# Used by the db service in docker-compose.yml.
POSTGRES_PASSWORD=replace-with-a-database-password

# Day 3: where the app and Alembic find PostgreSQL. Use the same password as above.
# localhost:5432 is the db service from docker-compose.yml.
# If Windows blocks psycopg ("Application Control policy"), use postgresql+pg8000://
# instead of postgresql+psycopg:// in both URLs below. See README, "Windows security".
LEAVEDESK_DATABASE_URL=postgresql+psycopg://leavedesk:replace-with-a-database-password@localhost:5432/leavedesk

# Only for running the database tests. They create and drop their own database
# on this server, so point it at the "postgres" maintenance database.
LEAVEDESK_TEST_DATABASE_URL=postgresql+psycopg://leavedesk:replace-with-a-database-password@localhost:5432/postgres
